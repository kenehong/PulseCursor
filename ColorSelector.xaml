<UserControl
    x:Class="LoadCursor.ColorSelector"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:LoadCursor">
    <Button
        AutomationProperties.Name="{x:Bind Label, Mode=OneWay}"
        AutomationProperties.HelpText="{x:Bind local:AppSettings.Hex(Color), Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind local:AppSettings.Hex(Color), Mode=OneWay}">
        <StackPanel Orientation="Horizontal" Spacing="8">
            <Border Width="32" Height="20"
                    BorderBrush="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                    BorderThickness="1" CornerRadius="{ThemeResource ControlCornerRadius}">
                <Border.Background>
                    <SolidColorBrush Color="{x:Bind Color, Mode=OneWay}" />
                </Border.Background>
            </Border>
            <FontIcon VerticalAlignment="Center"
                      FontFamily="{ThemeResource SymbolThemeFontFamily}"
                      FontSize="12" Glyph="&#xE70D;" />
        </StackPanel>
        <Button.Flyout>
            <Flyout>
                <ColorPicker Color="{x:Bind Color, Mode=TwoWay}"
                             IsAlphaEnabled="False"
                             AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" />
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
