<Application
    x:Class="LoadCursor.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Microsoft.UI.Xaml.Controls">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <controls:XamlControlsResources />
            </ResourceDictionary.MergedDictionaries>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
                    <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
                    <StaticResource x:Key="SettingsWindowBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="SettingsCardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="SettingsCardBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="PulseSurfaceBrush" Color="#F7F9FC" />
                    <SolidColorBrush x:Key="PulseBorderBrush" Color="#CBD3DE" />
                    <Thickness x:Key="PulseBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="PulseTextBrush" Color="#364152" />
                    <SolidColorBrush x:Key="PulseStrongTextBrush" Color="#111827" />
                    <SolidColorBrush x:Key="PulseMutedTextBrush" Color="#566273" />
                    <SolidColorBrush x:Key="PulseIdleBrush" Color="#7C8796" />
                    <StaticResource x:Key="PulseNormalBrush" ResourceKey="PulseTextBrush" />
                    <SolidColorBrush x:Key="PulseBusyBrush" Color="#805600" />
                    <SolidColorBrush x:Key="PulseHotBrush" Color="#A84610" />
                    <SolidColorBrush x:Key="PulseCriticalBrush" Color="#B42318" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="AcrylicBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="SurfaceStrokeColorFlyoutBrush" />
                    <Thickness x:Key="FlyoutBorderThemeThickness">1</Thickness>
                    <StaticResource x:Key="SettingsWindowBackgroundBrush" ResourceKey="LayerFillColorDefaultBrush" />
                    <StaticResource x:Key="SettingsCardBackgroundBrush" ResourceKey="CardBackgroundFillColorDefaultBrush" />
                    <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="CardStrokeColorDefaultBrush" />
                    <Thickness x:Key="SettingsCardBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="PulseSurfaceBrush" Color="#07090D" />
                    <SolidColorBrush x:Key="PulseBorderBrush" Color="#2A3240" />
                    <Thickness x:Key="PulseBorderThickness">1</Thickness>
                    <SolidColorBrush x:Key="PulseTextBrush" Color="#C3CCD6" />
                    <SolidColorBrush x:Key="PulseStrongTextBrush" Color="#E6EDF3" />
                    <SolidColorBrush x:Key="PulseMutedTextBrush" Color="#8B96A5" />
                    <SolidColorBrush x:Key="PulseIdleBrush" Color="#586170" />
                    <StaticResource x:Key="PulseNormalBrush" ResourceKey="PulseTextBrush" />
                    <SolidColorBrush x:Key="PulseBusyBrush" Color="#E3B341" />
                    <SolidColorBrush x:Key="PulseHotBrush" Color="#F0883E" />
                    <SolidColorBrush x:Key="PulseCriticalBrush" Color="#F85149" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="HighContrast">
                    <StaticResource x:Key="FlyoutPresenterBackground" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="FlyoutBorderThemeBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="FlyoutBorderThemeThickness">2</Thickness>
                    <StaticResource x:Key="SettingsWindowBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="SettingsCardBackgroundBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="SettingsCardBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="SettingsCardBorderThickness">2</Thickness>
                    <StaticResource x:Key="PulseSurfaceBrush" ResourceKey="SystemColorWindowColorBrush" />
                    <StaticResource x:Key="PulseBorderBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <Thickness x:Key="PulseBorderThickness">2</Thickness>
                    <StaticResource x:Key="PulseTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseStrongTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseMutedTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseIdleBrush" ResourceKey="SystemColorGrayTextColorBrush" />
                    <StaticResource x:Key="PulseNormalBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseBusyBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseHotBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                    <StaticResource x:Key="PulseCriticalBrush" ResourceKey="SystemColorWindowTextColorBrush" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
            <!-- Shared only by the peek surface and its three meters.
                 The supplied SVG deliberately uses 13px monospace and a 22px line rhythm. -->
            <FontFamily x:Key="PulseFontFamily">Consolas</FontFamily>
            <Style x:Key="PulseTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="FontFamily" Value="{StaticResource PulseFontFamily}" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="22" />
                <Setter Property="Foreground" Value="{ThemeResource PulseTextBrush}" />
            </Style>
            <Style x:Key="PulseStrongTextStyle" TargetType="TextBlock" BasedOn="{StaticResource PulseTextStyle}">
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource PulseStrongTextBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
